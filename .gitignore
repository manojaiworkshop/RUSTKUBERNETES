# =====================================================================
# Root .gitignore for KUBERNETES workspace
#   docs/            -> our architecture notes (committed)
#   rustkubernetes/  -> Rust rewrite (committed, minus build/runtime output)
#   kubernetes/      -> upstream clone of github.com/kubernetes/kubernetes
# =====================================================================

# ---------------------------------------------------------------------
# Upstream Kubernetes source (1.8G, has its own .git).
# Reference only — clone it again with:
#   git clone https://github.com/kubernetes/kubernetes.git
# ---------------------------------------------------------------------
/kubernetes/

# ---------------------------------------------------------------------
# Rust / Cargo build output
# ---------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb
# Cargo.lock is intentionally committed (workspace contains binaries)

# ---------------------------------------------------------------------
# rustkubernetes runtime output: local clusters, test runs, logs,
# generated PKI (private keys!), kubeconfigs, pid files, data dirs
# ---------------------------------------------------------------------
_output/
*.pid
*.out
*.log
logs/

# Secrets / credentials — never commit
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
kubeconfig
*.kubeconfig
admin.conf
kubelet.conf
controller-manager.conf
scheduler.conf
.env
.env.*
!.env.example

# ---------------------------------------------------------------------
# admin web UI (Node / Next.js under rustkubernetes/admin/web)
# ---------------------------------------------------------------------
node_modules/
.next/
out/
dist/
.turbo/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------
# Test / coverage / profiling artifacts
# ---------------------------------------------------------------------
coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
flamegraph.svg
perf.data*
junit*.xml

# ---------------------------------------------------------------------
# Archives / images
# ---------------------------------------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip

# ---------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.#*
\#*#

# ---------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Claude Code local files
# ---------------------------------------------------------------------
.claude/settings.local.json
