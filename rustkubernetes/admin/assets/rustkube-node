#!/bin/sh
# rustkube-node: runs the rustkubernetes services of one cluster on this machine.
#
#   rustkube-node start|stop|restart|status|remove CLUSTER
#   rustkube-node logs CLUSTER SERVICE [LINES]
#
# Services are the scripts in PREFIX/clusters/CLUSTER/services/*.sh (started in the
# order listed in services/order). They run under systemd (root), the user's
# systemd (`systemctl --user`) or, without systemd, a restart loop started with
# setsid/nohup. Logs go to PREFIX/clusters/CLUSTER/logs/SERVICE.log.
set -eu
PREFIX=$(cd "$(dirname "$0")/.." && pwd)
SUP=$(cat "$PREFIX/SUPERVISOR" 2>/dev/null || echo nohup)
CMD=${1:-}
CLUSTER=${2:-}
[ -n "$CMD" ] && [ -n "$CLUSTER" ] || { echo "usage: rustkube-node start|stop|restart|status|remove CLUSTER | logs CLUSTER SERVICE [LINES]" >&2; exit 2; }
CDIR="$PREFIX/clusters/$CLUSTER"

unit() { echo "rustkube-$CLUSTER-$1.service"; }
sctl() { if [ "$SUP" = systemd ]; then systemctl "$@"; else systemctl --user "$@"; fi; }
unitdir() { if [ "$SUP" = systemd ]; then echo /etc/systemd/system; else echo "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"; fi; }
services() { cat "$CDIR/services/order" 2>/dev/null || true; }
reverse() { services | sed -n '1!G;h;$p'; }

# Pod containers of this cluster's node (labelled by the kubelet).
pod_containers() {
  node=$(cat "$CDIR/NODE" 2>/dev/null || true)
  [ -n "$node" ] && docker ps -aq --filter "label=io.rustkubernetes.node=$node" 2>/dev/null || true
}

pid_alive() { [ -f "$CDIR/run/$1.pid" ] && kill -0 "$(cat "$CDIR/run/$1.pid")" 2>/dev/null; }

start_one() {
  svc=$1
  mkdir -p "$CDIR/logs" "$CDIR/run"
  case "$SUP" in
    systemd|systemd-user)
      d=$(unitdir); mkdir -p "$d"
      stop_line=""
      [ -f "$CDIR/services/$svc.stop.sh" ] && stop_line="ExecStopPost=-/bin/sh $CDIR/services/$svc.stop.sh"
      target=default.target; [ "$SUP" = systemd ] && target=multi-user.target
      cat > "$d/$(unit "$svc")" <<UNIT
[Unit]
Description=rustkubernetes $CLUSTER $svc
After=network-online.target docker.service

[Service]
ExecStart=/bin/sh $CDIR/services/$svc.sh
$stop_line
Restart=always
RestartSec=3

[Install]
WantedBy=$target
UNIT
      sctl daemon-reload
      sctl enable --now "$(unit "$svc")" >/dev/null 2>&1 || sctl restart "$(unit "$svc")"
      ;;
    *)
      pid_alive "$svc" && return 0
      setsid sh -c "while :; do sh '$CDIR/services/$svc.sh'; sleep 3; done" </dev/null >/dev/null 2>&1 &
      echo $! > "$CDIR/run/$svc.pid"
      ;;
  esac
  echo "started $svc"
}

stop_one() {
  svc=$1
  case "$SUP" in
    systemd|systemd-user) sctl disable --now "$(unit "$svc")" >/dev/null 2>&1 || true ;;
    *)
      if pid_alive "$svc"; then kill -- "-$(cat "$CDIR/run/$svc.pid")" 2>/dev/null || kill "$(cat "$CDIR/run/$svc.pid")" 2>/dev/null || true; fi
      rm -f "$CDIR/run/$svc.pid"
      [ -f "$CDIR/services/$svc.stop.sh" ] && sh "$CDIR/services/$svc.stop.sh" >/dev/null 2>&1 || true
      ;;
  esac
  echo "stopped $svc"
}

state_of() {
  case "$SUP" in
    systemd|systemd-user) sctl is-active "$(unit "$1")" 2>/dev/null || true ;;
    *) if pid_alive "$1"; then echo active; else echo inactive; fi ;;
  esac
}

case "$CMD" in
  start) [ -d "$CDIR" ] || { echo "no cluster $CLUSTER on this machine" >&2; exit 1; }; for s in $(services); do start_one "$s"; done ;;
  stop)
    for s in $(reverse); do stop_one "$s"; done
    ids=$(pod_containers); [ -n "$ids" ] && docker stop -t 10 $ids >/dev/null 2>&1 && echo "stopped $(echo "$ids" | wc -l) pod container(s)"
    true
    ;;
  restart) for s in $(reverse); do stop_one "$s"; done; for s in $(services); do start_one "$s"; done ;;
  status) for s in $(services); do echo "SERVICE $s $(state_of "$s")"; done ;;
  logs) tail -n "${4:-200}" "$CDIR/logs/${3:?service}.log" 2>/dev/null || true ;;
  remove)
    for s in $(reverse); do stop_one "$s"; done
    ids=$(pod_containers); [ -n "$ids" ] && docker rm -f $ids >/dev/null 2>&1 && echo "removed $(echo "$ids" | wc -l) pod container(s)"
    if [ "$SUP" != nohup ]; then rm -f "$(unitdir)"/rustkube-"$CLUSTER"-*.service; sctl daemon-reload || true; fi
    rm -rf "$CDIR"
    echo "removed cluster $CLUSTER"
    ;;
  *) echo "unknown command $CMD" >&2; exit 2 ;;
esac
